# the basic set of required environment variables for development, do not leave trailing spaces/whitespaces after the values, and do not include the # comment character in the actual .env file, these are just for documentation purposes here in the example file

# for the server configuration
# current environment, can be 'development', 'production', or 'test'
SO_NODE_ENV=development
# the port number the server will listen on, default is 3000, can be changed if needed
SO_PORT=3000

# for the database connection
# the hostname or IP address of the database server
SO_DB_HOST=localhost
# default MongoDB port, can be changed if needed
SO_DB_PORT=27017
# the name of the database to connect to, plain string without special characters
SO_DB_NAME=
# the username for authenticating to the database, plain string without special characters
SO_DB_USER=
# the password for authenticating to the database, can contain special characters but should be URL-encoded if used in a connection string
SO_DB_PASSWORD=
# the database to use for authentication, often 'admin' for MongoDB, plain string without special characters
SO_DB_AUTH_SOURCE=

# for authentication and security, you may want to add additional environment variables
# for example, a secret key for signing JWT tokens, or API keys for third-party services
# SO_JWT_SECRET=your_jwt_secret_key_here
# SO_API_KEY=your_api_key_here
